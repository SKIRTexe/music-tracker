# Copy this to .env.local and fill in the values

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# GitHub OAuth (optional — create at github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string → URI
#
# DATABASE_URL = the *pooled* connection (port 6543). Used by the running app.
#                Must end with ?pgbouncer=true&connection_limit=1 on serverless.
# DIRECT_URL   = the *direct* connection (port 5432). Used by prisma migrate.
#
# Both use the same password. Replace [PASSWORD] and [PROJECT-REF].
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# MusicBrainz requires real contact info in the User-Agent (email or site URL).
MB_CONTACT="you@example.com"

# Needed only to test from another device on your network (e.g. a phone) via a
# LAN address. Vercel trusts its own host automatically.
AUTH_TRUST_HOST=true

# ── Spotify export (optional) ─────────────────────────────────────────────────
# Create a free app at developer.spotify.com/dashboard. No app review needed;
# in Development mode you add users by email (up to 25).
#
# Register BOTH redirect URIs in the dashboard:
#   http://127.0.0.1:3000/api/spotify/callback     (local — "localhost" is rejected)
#   https://<your-app>.vercel.app/api/spotify/callback
# Spotify requires HTTPS except for loopback addresses with an explicit port.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
