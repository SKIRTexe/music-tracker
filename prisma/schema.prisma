generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: pooled connection (port 6543) for the app,
  // direct connection (port 5432) for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Playlist synced by the Spotify export, so re-exporting updates it in place.
  spotifyPlaylistId String?

  /// Set when a background playlist sync failed, so the library can warn that the
  /// playlist may be out of date. Cleared by the next successful sync.
  playlistSyncFailedAt DateTime?

  accounts       Account[]
  playlistTracks PlaylistTrack[]
  sessions Session[]
  logs     AlbumLog[]
  reviews  Review[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// One row per album or song a user has added to their library.
model AlbumLog {
  id          String   @id @default(cuid())
  userId      String
  mbid        String // MusicBrainz release id (albums) or recording id (songs)
  itemType    String   @default("ALBUM") // ALBUM | SONG
  albumTitle  String // the album title, or the song title for songs
  artistName  String
  parentAlbum String? // songs only: the album the song appears on
  releaseYear Int?
  coverUrl    String?
  artistMbid  String?
  status      String   @default("LISTENED") // LISTENED | LISTENING | WANT
  rating      Float? // 1.0 – 10.0
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@unique([userId, mbid])
  @@index([userId, addedAt])
}

/// Written reviews. No UI yet — see ARCHIVE.md section 10.
model Review {
  id         String   @id @default(cuid())
  userId     String
  albumLogId String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumLog AlbumLog @relation(fields: [albumLogId], references: [id], onDelete: Cascade)
}

/// MusicBrainz responses, cached across serverless instances.
/// The in-process cache dies with each Vercel lambda, so without this a repeat
/// search pays the full multi-second cost again.
model MbCache {
  url       String   @id
  body      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Tracks the Spotify export put into the playlist, so a sync can remove them when
/// their library row leaves Want to Listen — without touching tracks the user added
/// to that playlist by hand.
model PlaylistTrack {
  id         String   @id @default(cuid())
  userId     String
  playlistId String
  trackUri   String
  /// The library row (AlbumLog.mbid) this track came from.
  sourceMbid String
  addedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId, trackUri])
  @@index([userId, sourceMbid])
}
